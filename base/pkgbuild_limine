# pkgbuild_limine
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "limine"
pkgver  = "9.6.7"
pkgrel  = "1"
pkgdesc = "Limine bootloader — UEFI + BIOS x86_64 (pre-built binary)"
license = "BSD-2-Clause"
pkgtype = "binary"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source    = "sources/limine-bin-9.6.7.tar.gz"
md5sums   = "264be8719e2d7e2226d3c3f88031ef04"

build() {
    cd limine-${pkgver}
    # Binary package — nothing to compile
    true
}

package() {
    cd limine-${pkgver}
    # Install bootloader files
    install -dm755 "$pkgdir/usr/share/limine"
    install -dm755 "$pkgdir/usr/bin"
    # UEFI bootloader
    install -m644 BOOTX64.EFI     "$pkgdir/usr/share/limine/" 2>/dev/null || true
    install -m644 limine-uefi-cd.bin "$pkgdir/usr/share/limine/" 2>/dev/null || true
    # BIOS bootloader
    install -m644 limine-bios.sys "$pkgdir/usr/share/limine/" 2>/dev/null || true
    install -m644 limine-bios-cd.bin "$pkgdir/usr/share/limine/" 2>/dev/null || true
    # limine utility
    install -m755 limine           "$pkgdir/usr/bin/limine" 2>/dev/null || true
    install -m644 limine.h         "$pkgdir/usr/include/" 2>/dev/null || true
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}
