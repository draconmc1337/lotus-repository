	patch -p1 < "$srcdir/patches/musl-skaclient_start_async.patch"
	patch -p1 < "$srcdir/patches/musl-textmessage_recv_channel.patch"
	patch -p1 < "$srcdir/patches/musl-stddjb.patch"
	patch -p1 < "$srcdir/patches/musl-unsanitize_read.patch"
	patch -p1 < "$srcdir/patches/musl-ipc_timed_connect.patch"
	patch -p1 < "$srcdir/patches/musl-error_temp.patch"
	patch -p1 < "$srcdir/patches/musl-fd_lock.patch"
	patch -p1 < "$srcdir/patches/musl-socket_deadlineconnstamp6.patch"
	patch -p1 < "$srcdir/patches/musl-sanitize_read.patch"
	patch -p1 < "$srcdir/patches/musl-error_isalready.patch"
	patch -p1 < "$srcdir/patches/musl-socket_deadlineconnstamp46.patch"
