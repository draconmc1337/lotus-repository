# pkgbuild_shadow
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "shadow"
pkgver  = "4.17.4"
pkgrel  = "1"
pkgdesc = "Shadow password utilities — useradd, passwd, su"
license = "BSD-3-Clause"
pkgtype = "source"

depends     = ("libcap")
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ("etc/login.defs"; "etc/pam.d/login")

source    = "sources/shadow-4.17.4.tar.xz"
md5sums   = "469666ea82c203ce5b0116d26b3793a9"

build() {
    cd shadow-${pkgver}
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-nls \
        --without-audit \
        --without-selinux \
        --without-acl \
        --with-libcap
    make -j$(nproc)
}

package() {
    cd shadow-${pkgver}
    make DESTDIR="$pkgdir" install
    install -dm750 "$pkgdir/etc/shadow"
    # Default login.defs for musl
    cat > "$pkgdir/etc/login.defs" << 'LDEFS'
MAIL_DIR        /var/mail
PASS_MAX_DAYS   99999
PASS_MIN_DAYS   0
PASS_WARN_AGE   7
UID_MIN         1000
UID_MAX         60000
GID_MIN         1000
GID_MAX         60000
LDEFS
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}
