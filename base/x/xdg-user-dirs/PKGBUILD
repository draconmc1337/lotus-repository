pkgname = "xdg-user-dirs"
pkgver  = "0.18"
pkgrel  = "1"
pkgdesc = "# TODO: add description"
license = "custom"
url     = "https://TODO"
pkgtype = "source"

depends = (
    "glibc"
)

makedepends = (
    "docbook-xsl"
    "git"
    "meson"
    "systemd"
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "https://user-dirs.freedesktop.org/releases/xdg-user-dirs-0.18.tar.gz"
)

checksums = (
    "sha512:f523b2ba4f840a3c2a5730f72182fb5bb798187db769bfb7d36e9f780442813278a2c1bad656b4fb38428131241a51d07200a62b4d7b935d49a74be53f969716"
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/patches/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
