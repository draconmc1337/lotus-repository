prepare() {
	cd "$srcdir/xorg-server-21.1.15"
	patch -p1 < "$srcdir/patches/musl-glamor.patch"
	patch -p1 < "$srcdir/patches/musl-mieq.patch"
	patch -p1 < "$srcdir/patches/musl-kdrive.patch"
	patch -p1 < "$srcdir/patches/musl-xprFrame.patch"
	patch -p1 < "$srcdir/patches/musl-stub.patch"
	patch -p1 < "$srcdir/patches/musl-bundle-main.patch"
	patch -p1 < "$srcdir/patches/musl-bsd_init.patch"
	patch -p1 < "$srcdir/patches/musl-xf86_OSlib.patch"
	patch -p1 < "$srcdir/patches/musl-xf86pciBus.patch"
	patch -p1 < "$srcdir/patches/musl-xf86Events.patch"
	patch -p1 < "$srcdir/patches/musl-inpututils.patch"
	patch -p1 < "$srcdir/patches/musl-osinit.patch"
	patch -p1 < "$srcdir/patches/musl-backtrace.patch"
	patch -p1 < "$srcdir/patches/musl-misc.patch"
	patch -p1 < "$srcdir/patches/musl-os.patch"
}

build() {
	cd "$srcdir/xorg-server-21.1.15"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared \
		-Dsystemd=disabled
	ninja -C build
}

check() {
	cd "$srcdir/xorg-server-21.1.15"
	ninja -C build test
}

package() {
	cd "$srcdir/xorg-server-21.1.15"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
