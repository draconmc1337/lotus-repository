pkgname = "xdg-utils"
pkgver  = "1.2.1"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://gitlab.freedesktop.org/xdg/xdg-utils/-/archive/v1.2.1/xdg-utils-v1.2.1.tar.gz"
md5sums = "f6b648c064464c2636884c05746e80428110a576f8daacf46ef2e554dcfdae75"

prepare() {
	cd "$srcdir/xdg-utils-v1.2.1  # extracted dir: xdg-utils-v1.2.1"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/xdg-utils-v1.2.1  # extracted dir: xdg-utils-v1.2.1"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

check() {
	cd "$srcdir/xdg-utils-v1.2.1  # extracted dir: xdg-utils-v1.2.1"
	make check
}

package() {
	cd "$srcdir/xdg-utils-v1.2.1  # extracted dir: xdg-utils-v1.2.1"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
