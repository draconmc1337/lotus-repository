pkgname = "xz"
pkgver  = "5.6.3"
pkgrel  = "1"
pkgdesc = "# TODO: add description"
license = "BSD"
url     = "https://TODO"
pkgtype = "source"

depends = (
    "glibc"
    "sh"
)

makedepends = (
    "liblzma"
    "intl"
    "gettext"
    "threads"
    "glib2"
    "doxygen"
    "git"
    "po4a"
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "https://github.com/tukaani-project/xz/releases/download/v5.6.3/xz-5.6.3.tar.xz"
    "patches/musl-tuklib_progname.patch"
)

checksums = (
    "sha512:1449f3b55819fb7f46855e550e367e96d658f523531fc2a65c2e1f1b847de86bf2fa50f3909f42cbff94a56b0cf8b0b5cd278097622da980119548f61e245f0a"
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-tuklib_progname.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake --build build --target test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
