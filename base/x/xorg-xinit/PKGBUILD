)

checksums = (
    "sha512:4b62c2edd97b40133577cbba88b3f31b36c5634b4eb667ef0c302e8358dc1c55a255abe42aaadc910d8aa9ea0e3add157a12a301382f1cdbe091df4e1215fae0"
    "SKIP"  # musl patch — review before using sha512
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/xinit-1.4.2"
	patch -p1 < "$srcdir/patches/musl-server.patch"
	patch -p1 < "$srcdir/patches/musl-client.patch"
}

build() {
	cd "$srcdir/xinit-1.4.2"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/xinit-1.4.2"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
