license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ("openssl")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://xorg.freedesktop.org/archive/individual/app/xinit-1.4.3.tar.xz"
md5sums = "86409f21a6a31148d2c1c17bf5f2d904eb5ef455f9dc67c49fbd0c10ab18fd5a"

prepare() {
	cd "$srcdir/xinit-1.4.3  # extracted dir: xinit-1.4.3"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/xinit-1.4.3  # extracted dir: xinit-1.4.3"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/xinit-1.4.3  # extracted dir: xinit-1.4.3"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
