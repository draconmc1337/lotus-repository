prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-search.patch"
	patch -p1 < "$srcdir/patches/musl-linear.patch"
	patch -p1 < "$srcdir/patches/musl-index.patch"
	patch -p1 < "$srcdir/patches/musl-color.patch"
	patch -p1 < "$srcdir/patches/musl-symbol.patch"
	patch -p1 < "$srcdir/patches/musl-ptable.patch"
	patch -p1 < "$srcdir/patches/musl-font.patch"
	patch -p1 < "$srcdir/patches/musl-tmpfile.patch"
	patch -p1 < "$srcdir/patches/musl-error.patch"
	patch -p1 < "$srcdir/patches/musl-nametoindex.patch"
	patch -p1 < "$srcdir/patches/musl-curtime.patch"
	patch -p1 < "$srcdir/patches/musl-input.patch"
	patch -p1 < "$srcdir/patches/musl-troff.patch"
	patch -p1 < "$srcdir/patches/musl-groff.patch"
	patch -p1 < "$srcdir/patches/musl-indxbib.patch"
	patch -p1 < "$srcdir/patches/musl-hpftodit.patch"
	patch -p1 < "$srcdir/patches/musl-lookbib.patch"
	patch -p1 < "$srcdir/patches/musl-tfmtodit.patch"
	patch -p1 < "$srcdir/patches/musl-lkbib.patch"
	patch -p1 < "$srcdir/patches/musl-addftinfo.patch"
	patch -p1 < "$srcdir/patches/musl-eqn.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
