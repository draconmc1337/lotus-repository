prepare() {
	cd "$srcdir/gdk-pixbuf-2.42.12"
	patch -p1 < "$srcdir/patches/musl-pixbuf-lowmem.patch"
	patch -p1 < "$srcdir/patches/musl-io-jpeg.patch"
}

build() {
	cd "$srcdir/gdk-pixbuf-2.42.12"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/gdk-pixbuf-2.42.12"
	ninja -C build test
}

package() {
	cd "$srcdir/gdk-pixbuf-2.42.12"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
