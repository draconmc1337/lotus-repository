prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-sanitizer_platform_limits_posix.patch"
	patch -p1 < "$srcdir/patches/musl-sanitizer_platform.patch"
	patch -p1 < "$srcdir/patches/musl-lrealpath.patch"
	patch -p1 < "$srcdir/patches/musl-getopt1.patch"
	patch -p1 < "$srcdir/patches/musl-obstack.patch"
	patch -p1 < "$srcdir/patches/musl-getopt.patch"
	patch -p1 < "$srcdir/patches/musl-async.patch"
	patch -p1 < "$srcdir/patches/musl-error.patch"
	patch -p1 < "$srcdir/patches/musl-gengtype.patch"
	patch -p1 < "$srcdir/patches/musl-reload1.patch"
	patch -p1 < "$srcdir/patches/musl-rtl-error.patch"
	patch -p1 < "$srcdir/patches/musl-lra-eliminations.patch"
	patch -p1 < "$srcdir/patches/musl-opts.patch"
	patch -p1 < "$srcdir/patches/musl-gcc.patch"
	patch -p1 < "$srcdir/patches/musl-lra.patch"
