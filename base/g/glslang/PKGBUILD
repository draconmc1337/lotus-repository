pkgname = "glslang"
pkgver  = "15.0.0"
pkgrel  = "1"
pkgdesc = "# TODO: add description"
license = "custom"
url     = "https://TODO"
pkgtype = "source"

depends = (
    "glibc"
    "libstdc++"
    "spirv-tools"
)

makedepends = (
    "spirv-tools-opt"
    "cmake"
    "git"
    "ninja"
    "python"
    "spirv-headers"
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "https://github.com/KhronosGroup/glslang/archive/15.0.0/glslang-15.0.0.tar.gz"
    "patches/musl-glslang_tab.patch"
)

checksums = (
    "sha512:b246c6f280891b7c9b6cd0b5e85e03ccf1fe173cdfc40e566339a5698176cbcfe23eb7aeaba277f071222d76b9f2a00376d790d4d604aedad82e6196fab7fc70"
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-glslang_tab.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake --build build --target test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
