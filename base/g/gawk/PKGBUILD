prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-gettext.patch"
	patch -p1 < "$srcdir/patches/musl-fnmatch.patch"
	patch -p1 < "$srcdir/patches/musl-config.patch"
	patch -p1 < "$srcdir/patches/musl-getopt1.patch"
	patch -p1 < "$srcdir/patches/musl-getopt.patch"
	patch -p1 < "$srcdir/patches/musl-main.patch"
	patch -p1 < "$srcdir/patches/musl-cmd.patch"
	patch -p1 < "$srcdir/patches/musl-debug.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
