# pkgbuild_gcc
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "gcc"
pkgver  = "15.1.0"
pkgrel  = "1"
pkgdesc = "GNU Compiler Collection — C and C++ (musl-native)"
license = "GPL-3.0"
pkgtype = "source"

depends     = ("musl"; "binutils"; "gmp"; "mpfr"; "mpc"; "zlib")
makedepends = ("gmp"; "mpfr"; "mpc")
replaces    = ()
conflicts   = ()
backup      = ("etc/gcc/lotus.specs")

source    = "sources/gcc-15.1.0.tar.xz"
md5sums   = "e55d13c55428bca27b4d2ea02f883135"

build() {
    cd gcc-${pkgver}
    # Pull math deps into tree
    tar -xf /sources/gmp-6.3.0.tar.xz  && mv gmp-6.3.0  gmp
    tar -xf /sources/mpfr-4.2.2.tar.xz && mv mpfr-4.2.2 mpfr
    tar -xf /sources/mpc-1.3.1.tar.gz  && mv mpc-1.3.1  mpc
    mkdir build && cd build
    ../configure \
        --prefix=/usr \
        --enable-languages=c,c++ \
        --enable-shared \
        --enable-threads=posix \
        --enable-__cxa_atexit \
        --enable-clocale=generic \
        --enable-default-pie \
        --enable-default-ssp \
        --disable-multilib \
        --disable-nls \
        --disable-libsanitizer \
        --disable-libssp \
        --disable-werror \
        --with-system-zlib \
        --with-native-system-header-dir=/usr/include
    make -j$(nproc)
}

package() {
    cd gcc-${pkgver}
    cd build
    make DESTDIR="$pkgdir" install
    ln -sfv gcc "$pkgdir"/usr/bin/cc
    # Remove static libs to save space
    find "$pkgdir"/usr/lib/gcc -name '*.la' -delete
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}

uninstall() {
    rm -f /usr/bin/{gcc,g++,cc,cpp,c++,gcov}
    rm -rf /usr/lib/gcc
}
