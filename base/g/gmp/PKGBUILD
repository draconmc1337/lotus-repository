prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-obvprintf.patch"
	patch -p1 < "$srcdir/patches/musl-obprntffuns.patch"
	patch -p1 < "$srcdir/patches/musl-obprintf.patch"
	patch -p1 < "$srcdir/patches/musl-clocale.patch"
	patch -p1 < "$srcdir/patches/musl-t-printf.patch"
	patch -p1 < "$srcdir/patches/musl-t-locale.patch"
	patch -p1 < "$srcdir/patches/musl-t-scanf.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
