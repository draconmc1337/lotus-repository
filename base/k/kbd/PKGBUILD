pkgname = "kbd"
pkgver  = "2.6.4"
pkgrel  = "1"
pkgdesc = "# TODO: add description"
license = "custom"
url     = "https://TODO"
pkgtype = "source"

depends = (
    "glibc"
    "gzip"
    "pam"
)

makedepends = (
    "check"
    "git"
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "https://www.kernel.org/pub/linux/utils/kbd/kbd-2.6.4.tar.xz"
    "patches/musl-parser.patch"
)

checksums = (
    "sha512:a4149cb0f85fd79b333a6c137d70896a30ebceb1cf9d4b5eef3abb2e1866d83b46cee651e4f3e512bf7e0ccd232d955c14f693e57020a3626e4943c4695fc8ab"
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-parser.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
