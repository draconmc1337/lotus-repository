pkgname = "libxi"
pkgver  = "1.8.2"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ("x11")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://xorg.freedesktop.org/archive/individual/lib/libXi-1.8.2.tar.xz"
md5sums = "d0e0555e53d6e2114eabfa44226ba162d2708501a25e18d99cfb35c094c6c104"

prepare() {
	cd "$srcdir/libXi-1.8.2  # extracted dir: libXi-1.8.2"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/libXi-1.8.2  # extracted dir: libXi-1.8.2"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/libXi-1.8.2  # extracted dir: libXi-1.8.2"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
