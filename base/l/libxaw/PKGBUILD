pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://xorg.freedesktop.org/archive/individual/lib/libXaw-1.0.16.tar.xz"
md5sums = "731d572b54c708f81e197a6afa8016918e2e06dfd3025e066ca642a5b8c39c8f"

prepare() {
	cd "$srcdir/libXaw-1.0.16  # extracted dir: libXaw-1.0.16"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/libXaw-1.0.16  # extracted dir: libXaw-1.0.16"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/libXaw-1.0.16  # extracted dir: libXaw-1.0.16"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
