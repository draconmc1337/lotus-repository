# pkgbuild_libfontenc
# Lotus Linux package recipe — repo: base
# Generated by LotusPacMan v3.0.0
# Review and test before committing!

pkgname = "libfontenc"
pkgver  = "1.1.9"
pkgrel  = "1"
pkgdesc = "Enable non-standardized system API extensions"
license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ("fontutil"; "zlib"; "xproto")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://xorg.freedesktop.org/archive/individual/lib/libfontenc-1.1.9.tar.xz"
md5sums = "9d8392705cb10803d5fe1d27d236cbab3f664e26841ce01916bbbe430cf273e2"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
