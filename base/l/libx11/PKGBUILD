pkgver  = "1.8.13"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://xorg.freedesktop.org/archive/individual/lib/libX11-1.8.13.tar.xz"
md5sums = "69606f485c2c07c14ef64f75b7bb326d48587af33795d9ab3e607c0b5f94f11c"

prepare() {
	cd "$srcdir/libX11-1.8.13  # extracted dir: libX11-1.8.13"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/libX11-1.8.13  # extracted dir: libX11-1.8.13"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/libX11-1.8.13  # extracted dir: libX11-1.8.13"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
