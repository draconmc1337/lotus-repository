pkgname = "libevdev"
pkgver  = "1.13.3"
pkgrel  = "1"
pkgdesc = "Handler library for evdev events"
license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ("check")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://gitlab.freedesktop.org/libevdev/libevdev/-/archive/libevdev-1.13.3/libevdev-libevdev-1.13.3.tar.gz"
md5sums = "39e431563f0b35e4794b3af3f61bc05f81ef5d25f10238af9768ddf4589abef7"

prepare() {
	cd "$srcdir/libevdev-libevdev-1.13.3  # extracted dir: libevdev-libevdev-1.13.3"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/libevdev-libevdev-1.13.3  # extracted dir: libevdev-libevdev-1.13.3"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/libevdev-libevdev-1.13.3  # extracted dir: libevdev-libevdev-1.13.3"
	ninja -C build test
}

package() {
	cd "$srcdir/libevdev-libevdev-1.13.3  # extracted dir: libevdev-libevdev-1.13.3"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
