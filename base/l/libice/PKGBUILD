pkgname = "libice"
pkgver  = "1.1.2"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ("libbsd-overlay")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://xorg.freedesktop.org/archive/individual/lib/libICE-1.1.2.tar.xz"
md5sums = "974e4ed414225eb3c716985df9709f4da8d22a67a2890066bc6dfc89ad298625"

prepare() {
	cd "$srcdir/libICE-1.1.2  # extracted dir: libICE-1.1.2"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/libICE-1.1.2  # extracted dir: libICE-1.1.2"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/libICE-1.1.2  # extracted dir: libICE-1.1.2"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
