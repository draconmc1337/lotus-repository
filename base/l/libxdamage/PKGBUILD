pkgver  = "1.1.7"
pkgrel  = "1"
pkgdesc = "X Damage Library"
license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ("damageproto"; "xfixes"; "fixesproto"; "xextproto"; "x11"; "xproto")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://xorg.freedesktop.org/archive/individual/lib/libXdamage-1.1.7.tar.xz"
md5sums = "127067f521d3ee467b97bcb145aeba1078e2454d448e8748eb984d5b397bde24"

prepare() {
	cd "$srcdir/libXdamage-1.1.7  # extracted dir: libXdamage-1.1.7"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/libXdamage-1.1.7  # extracted dir: libXdamage-1.1.7"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

package() {
	cd "$srcdir/libXdamage-1.1.7  # extracted dir: libXdamage-1.1.7"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
