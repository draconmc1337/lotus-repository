pkgver  = "0.4.7"
pkgrel  = "1"
pkgdesc = "X Composite Extension Library"
license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ("compositeproto"; "xproto"; "x11"; "xfixes")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://xorg.freedesktop.org/archive/individual/lib/libXcomposite-0.4.7.tar.xz"
md5sums = "8bdf310967f484503fa51714cf97bff0723d9b673e0eecbf92b3f97c060c8ccb"

prepare() {
	cd "$srcdir/libXcomposite-0.4.7  # extracted dir: libXcomposite-0.4.7"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/libXcomposite-0.4.7  # extracted dir: libXcomposite-0.4.7"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

package() {
	cd "$srcdir/libXcomposite-0.4.7  # extracted dir: libXcomposite-0.4.7"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
