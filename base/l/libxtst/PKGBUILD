pkgname = "libxtst"
pkgver  = "1.2.5"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ("xext")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://xorg.freedesktop.org/archive/individual/lib/libXtst-1.2.5.tar.xz"
md5sums = "b50d4c25b97009a744706c1039c598f4d8e64910c9fde381994e1cae235d9242"

prepare() {
	cd "$srcdir/libXtst-1.2.5  # extracted dir: libXtst-1.2.5"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/libXtst-1.2.5  # extracted dir: libXtst-1.2.5"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/libXtst-1.2.5  # extracted dir: libXtst-1.2.5"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
