pkgver  = "1.5.4"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://xorg.freedesktop.org/archive/individual/lib/libXrandr-1.5.4.tar.xz"
md5sums = "1ad5b065375f4a85915aa60611cc6407c060492a214d7f9daf214be752c3b4d3"

prepare() {
	cd "$srcdir/libXrandr-1.5.4  # extracted dir: libXrandr-1.5.4"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/libXrandr-1.5.4  # extracted dir: libXrandr-1.5.4"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/libXrandr-1.5.4  # extracted dir: libXrandr-1.5.4"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
