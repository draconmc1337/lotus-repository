)

checksums = (
    "sha512:ac20ff9506df254cdd8e6cd56ed9396de2101724371ef6cf6652f690764e93839eea15690c2b73e752ff8d2a6c1a235c8f288a04f73003d24d456413f3ee49e6"
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-debugger.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	make -j$(nproc) PREFIX=/usr
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make install PREFIX="$pkgdir/usr"
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
