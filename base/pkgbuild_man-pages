# pkgbuild_man-pages
# Lotus Linux base system package
# pkgtype = "source"

# Size-optimized: -Os for smaller footprint
CFLAGS_EXTRA   = "-Os -march=x86-64-v2 -mtune=generic -ffunction-sections -fdata-sections"
LDFLAGS_EXTRA  = "-Wl,--gc-sections" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "man-pages"
pkgver  = "6.13"
pkgrel  = "1"
pkgdesc = "Linux manual pages — sections 1-8"
license = "GPL-2.0"
pkgtype = "source"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source    = "sources/man-pages-6.13.tar.xz"
md5sums   = "5349329fef307e755933266b26eac873"

build() {
    cd man-pages-${pkgver}
    true  # no build step
}

package() {
    cd man-pages-${pkgver}
    make prefix=/usr DESTDIR="$pkgdir" install
}
