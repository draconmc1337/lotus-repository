prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-mmap-anon-util.patch"
	patch -p1 < "$srcdir/patches/musl-sys_socket.in.patch"
	patch -p1 < "$srcdir/patches/musl-sys_ioctl.in.patch"
	patch -p1 < "$srcdir/patches/musl-test-sigaction.patch"
	patch -p1 < "$srcdir/patches/musl-strerror_r.patch"
	patch -p1 < "$srcdir/patches/musl-test-stdlib-c++.patch"
	patch -p1 < "$srcdir/patches/musl-test-canonicalize-lgpl.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
