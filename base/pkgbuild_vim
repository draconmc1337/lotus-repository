# pkgbuild_vim
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "vim"
pkgver  = "9.1.1400"
pkgrel  = "1"
pkgdesc = "Vi IMproved — highly configurable text editor"
license = "Vim"
pkgtype = "source"

depends     = ("ncurses"; "acl")
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ("etc/vim/vimrc")

source    = "sources/vim-9.1.1400.tar.gz"
md5sums   = "9aaf784b13ac60b501565072d12fc498"

build() {
    cd vim-${pkgver}
    echo '#define SYS_VIMRC_FILE "/etc/vim/vimrc"' >> src/feature.h
    ./configure \
        --prefix=/usr \
        --with-features=huge \
        --enable-multibyte \
        --without-x \
        --disable-gui \
        --with-tlib=ncursesw
    make -j$(nproc)
}

package() {
    cd vim-${pkgver}
    make DESTDIR="$pkgdir" install
    ln -sfv vim "$pkgdir/usr/bin/vi"
    install -dm755 "$pkgdir/etc/vim"
    cat > "$pkgdir/etc/vim/vimrc" << 'VIMRC'
set nocompatible
syntax on
set number
set tabstop=4 shiftwidth=4 expandtab
set hlsearch incsearch
set encoding=utf-8
colorscheme desert
VIMRC
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}
