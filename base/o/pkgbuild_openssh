# pkgbuild_openssh
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "openssh"
pkgver  = "10.0p2"
pkgrel  = "1"
pkgdesc = "OpenSSH client, server and utilities"
license = "BSD-2-Clause"
pkgtype = "source"

depends     = ("openssl"; "zlib"; "libcap")
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ("etc/ssh/sshd_config"; "etc/ssh/ssh_config")

source    = "sources/openssh-10.0p2.tar.gz"
md5sums   = "689148621a2eaa734497b12bed1c5202"

build() {
    cd openssh-${pkgver}
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc/ssh \
        --with-ssl-dir=/usr \
        --with-privsep-path=/var/empty \
        --without-pam \
        --without-selinux
    make -j$(nproc)
}

package() {
    cd openssh-${pkgver}
    make DESTDIR="$pkgdir" install
    install -dm700 "$pkgdir/var/empty"
    # Default sshd_config — disable root login
    sed -i 's/#PermitRootLogin.*/PermitRootLogin no/' "$pkgdir/etc/ssh/sshd_config" 
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}
