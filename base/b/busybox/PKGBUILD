prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-seedrng.patch"
	patch -p1 < "$srcdir/patches/musl-platform.patch"
	patch -p1 < "$srcdir/patches/musl-libbb.patch"
	patch -p1 < "$srcdir/patches/musl-unzip.patch"
	patch -p1 < "$srcdir/patches/musl-hardshutdown.patch"
	patch -p1 < "$srcdir/patches/musl-makedev.patch"
	patch -p1 < "$srcdir/patches/musl-xreadlink.patch"
	patch -p1 < "$srcdir/patches/musl-httpd.patch"
	patch -p1 < "$srcdir/patches/musl-init.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	make -j$(nproc) PREFIX=/usr
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make install PREFIX="$pkgdir/usr"
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
