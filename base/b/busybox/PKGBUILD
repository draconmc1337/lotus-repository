# pkgbuild_busybox
# Lotus Linux base system package
# pkgtype = "source"

# Size-optimized: -Os for smaller footprint
CFLAGS_EXTRA   = "-Os -march=x86-64-v2 -mtune=generic -ffunction-sections -fdata-sections"
LDFLAGS_EXTRA  = "-Wl,--gc-sections" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "busybox"
pkgver  = "1.37.0"
pkgrel  = "1"
pkgdesc = "Multi-call binary with tiny UNIX utilities (musl-static)"
license = "GPL-2.0"
pkgtype = "source"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source    = "sources/busybox-1.37.0.tar.bz2"
md5sums   = "865b68ab41b923d9cdbebf3f2c8b04ec"

build() {
    cd busybox-${pkgver}
    make defconfig
    # Enable musl static build
    sed -i 's/# CONFIG_STATIC is not set/CONFIG_STATIC=y/'  .config
    sed -i 's/# CONFIG_FEATURE_SUID is not set/CONFIG_FEATURE_SUID=y/' .config
    make -j$(nproc) LDFLAGS="--static"
    
}

package() {
    cd busybox-${pkgver}
    install -Dm755 busybox "$pkgdir/usr/bin/busybox"
    # Install applet symlinks
    ./busybox --list-full | while read applet; do
        dir=$(dirname "$applet")
        base=$(basename "$applet")
        install -dm755 "$pkgdir/$dir"
        ln -sfv /usr/bin/busybox "$pkgdir/$applet" 2>/dev/null || true
    done
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}

uninstall() {
    rm -f /usr/bin/busybox
}
