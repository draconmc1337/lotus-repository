# PKGBUILD — busybox
# Lotus Linux
# https://busybox.net

pkgname="busybox"
pkgver="1.37.0"
pkgrel="1"

pkgdesc="Tiny versions of common UNIX utilities in a single executable"
arch=("x86_64")
url="https://busybox.net"
license=("GPL-2.0-only")

pkgtype="source"

depends=()

makedepends=(
    "musl"
    "kernel-headers-musl"
    "ncurses"
    "bzip2"
)

conflicts=()
replaces=()
backup=()

sources=(
    "https://busybox.net/downloads/busybox-${pkgver}.tar.bz2"

    "patches/musl-seedrng.patch"
    "patches/musl-platform.patch"
    "patches/musl-libbb.patch"
    "patches/musl-unzip.patch"
    "patches/musl-hardshutdown.patch"
    "patches/musl-makedev.patch"
    "patches/musl-xreadlink.patch"
    "patches/musl-httpd.patch"
    "patches/musl-init.patch"
)

checksums=(
    "sha512:ad8fd06f082699774f990a53d7a73b189ed404fe0a2166aff13eae4d9d8ee5c9239493befe949c98801fe7897520dbff3ed0224faa7205854ce4fa975e18467e"

    "SKIP"
    "SKIP"
    "SKIP"
    "SKIP"
    "SKIP"
    "SKIP"
    "SKIP"
    "SKIP"
    "SKIP"
)

prepare() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    for patch in \
        musl-seedrng \
        musl-platform \
        musl-libbb \
        musl-unzip \
        musl-hardshutdown \
        musl-makedev \
        musl-xreadlink \
        musl-httpd \
        musl-init
    do
        patch -Np1 -i "${srcdir}/patches/${patch}.patch"
    done

    make defconfig
}

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    make \
        PREFIX=/usr \
        -j"$(nproc)"
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"

    make \
        CONFIG_PREFIX="${pkgdir}" \
        PREFIX=/usr \
        install

    find "${pkgdir}" \
        -type f \
        \( -perm -111 -o -name "*.so*" \) \
        -exec ${STRIP:-strip} --strip-unneeded {} + \
        2>/dev/null || true

    rm -rf \
        "${pkgdir}/usr/share/doc" \
        "${pkgdir}/usr/share/info" \
        "${pkgdir}/usr/share/man" \
        "${pkgdir}/usr/share/locale"
}
