prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-fixits.patch"
	patch -p1 < "$srcdir/patches/musl-system.patch"
	patch -p1 < "$srcdir/patches/musl-uniqstr.patch"
	patch -p1 < "$srcdir/patches/musl-getargs.patch"
	patch -p1 < "$srcdir/patches/musl-scan-skel.patch"
	patch -p1 < "$srcdir/patches/musl-complain.patch"
	patch -p1 < "$srcdir/patches/musl-files.patch"
	patch -p1 < "$srcdir/patches/musl-yacc.patch"
	patch -p1 < "$srcdir/patches/musl-glr.patch"
	patch -p1 < "$srcdir/patches/musl-signal.in.patch"
	patch -p1 < "$srcdir/patches/musl-openat-die.patch"
	patch -p1 < "$srcdir/patches/musl-progname.patch"
	patch -p1 < "$srcdir/patches/musl-getprogname.patch"
	patch -p1 < "$srcdir/patches/musl-sys_ioctl.in.patch"
	patch -p1 < "$srcdir/patches/musl-math.in.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
