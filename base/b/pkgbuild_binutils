# pkgbuild_binutils
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "binutils"
pkgver  = "2.44"
pkgrel  = "1"
pkgdesc = "GNU Binary Utilities — assembler, linker, objdump"
license = "GPL-3.0"
pkgtype = "source"

depends     = ("musl"; "zlib")
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source    = "sources/binutils-2.44.tar.xz"
md5sums   = "49912ce774666a30806141f106124294"

build() {
    cd binutils-${pkgver}
    mkdir -p build && cd build
    ../configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --enable-shared \
        --enable-gold \
        --enable-ld=default \
        --enable-plugins \
        --enable-64-bit-bfd \
        --disable-nls \
        --disable-werror \
        --disable-multilib \
        --with-system-zlib
    make -j$(nproc) tooldir=/usr
}

package() {
    cd binutils-${pkgver}
    cd build
    make DESTDIR="$pkgdir" tooldir=/usr install
    rm -f "$pkgdir"/usr/lib/lib{bfd,ctf,ctf-nobfd,gprofng,opcodes,sframe}.a
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}

uninstall() {
    rm -f /usr/bin/{ar,as,ld,nm,objcopy,objdump,ranlib,readelf,size,strings,strip}
}
