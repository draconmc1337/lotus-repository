# pkgbuild_bash
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "bash"
pkgver  = "5.3"
pkgrel  = "1"
pkgdesc = "GNU Bourne Again SHell"
license = "GPL-3.0"
pkgtype = "source"

depends     = ("readline"; "ncurses")
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ("etc/bash/bashrc"; "etc/bash/bash_profile")

source    = "sources/bash-5.3.tar.gz"
md5sums   = "977c8c0c5ae6309191e7768e28ebc951"

build() {
    cd bash-${pkgver}
    ./configure \
        --prefix=/usr \
        --without-bash-malloc \
        --with-installed-readline \
        --enable-readline \
        --sysconfdir=/etc
    make -j$(nproc)
}

package() {
    cd bash-${pkgver}
    make DESTDIR="$pkgdir" install
    ln -sfv bash "$pkgdir/usr/bin/sh"
    install -dm755 "$pkgdir/etc/bash"
    cat > "$pkgdir/etc/bash/bashrc" << 'BASHRC'
# /etc/bash/bashrc — Lotus Linux system-wide bashrc
[ -z "$PS1" ] && return
PS1='\[\033[1;32m\]\u@\h\[\033[0m\]:\[\033[1;34m\]\w\[\033[0m\]\$ '
alias ls='ls --color=auto'
alias ll='ls -lh'
alias la='ls -lAh'
BASHRC
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}

uninstall() {
    rm -f /usr/bin/bash /usr/bin/sh
}
