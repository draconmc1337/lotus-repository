prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-aarch64-dis.patch"
	patch -p1 < "$srcdir/patches/musl-obstack.patch"
	patch -p1 < "$srcdir/patches/musl-lrealpath.patch"
	patch -p1 < "$srcdir/patches/musl-getopt1.patch"
	patch -p1 < "$srcdir/patches/musl-getopt.patch"
	patch -p1 < "$srcdir/patches/musl-main.patch"
	patch -p1 < "$srcdir/patches/musl-ldlang.patch"
	patch -p1 < "$srcdir/patches/musl-plugin-api.patch"
	patch -p1 < "$srcdir/patches/musl-obstack.patch"
	patch -p1 < "$srcdir/patches/musl-objalloc.patch"
	patch -p1 < "$srcdir/patches/musl-unwind.patch"
	patch -p1 < "$srcdir/patches/musl-yyscript.patch"
	patch -p1 < "$srcdir/patches/musl-write.patch"
	patch -p1 < "$srcdir/patches/musl-symbols.patch"
	patch -p1 < "$srcdir/patches/musl-subsegs.patch"
