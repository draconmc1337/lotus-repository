# pkgbuild_cairo
# Lotus Linux package recipe — repo: base
# Generated by LotusPacMan v3.0.0
# Review and test before committing!

pkgname = "cairo"
pkgver  = "1.18.4"
pkgrel  = "1"
pkgdesc = "feature['description'] + ' for cairo graphics library"
license = "LGPL-2.1"
pkgtype = "source"

depends     = ()
makedepends = ("gtk+-2.0"; "lzo2"; "zlib"; "libpng"; "fontconfig"; "freetype2"; "x11"; "xext"; "xrender"; "xcb"; "xcb-render"; "x11-xcb"; "xcb-shm"; "appleframeworks"; "gobject-2.0"; "glib-2.0"; "libspectre"; "poppler-glib"; "librsvg-2.0"; "pixman-1"; "")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://gitlab.freedesktop.org/cairo/cairo/-/archive/1.18.4/cairo-1.18.4.tar.gz"
md5sums = "2f3e6e665dbbb420809102b71ad7d0f7ce870a0b1bf8b34c073f06aefb511fc6"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	ninja -C build test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
