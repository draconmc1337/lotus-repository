	patch -p1 < "$srcdir/patches/musl-curl_quiche.patch"
	patch -p1 < "$srcdir/patches/musl-curl_osslq.patch"
	patch -p1 < "$srcdir/patches/musl-curl_ngtcp2.patch"
	patch -p1 < "$srcdir/patches/musl-spnego_sspi.patch"
	patch -p1 < "$srcdir/patches/musl-digest_sspi.patch"
