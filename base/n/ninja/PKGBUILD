pkgname = "ninja"
pkgver  = "1.12.1"
pkgrel  = "1"
pkgdesc = "# TODO: add description"
license = "Apache-2.0"
url     = "https://TODO"
pkgtype = "source"

depends = (
    "glibc"
    "libgcc"
    "libstdc++"
)

makedepends = (
    "gtest"
    "threads"
    "cmake"
    "python"
    "re2c"
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "https://github.com/ninja-build/ninja/archive/v1.12.1/ninja-1.12.1.tar.gz"
    "patches/musl-util.patch"
)

checksums = (
    "sha512:d6e6f0e89a4844a69069ff0c7cefc07704a41c7b0c062a57534de87decdde63e27928147b321111b806aa7efa1061f031a1319b074391db61b0cbdccf096954c"
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-util.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake --build build --target test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
