# pkgbuild_ncurses
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "ncurses"
pkgver  = "6.5"
pkgrel  = "1"
pkgdesc = "Terminal handling library — ncurses/terminfo"
license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source    = "sources/ncurses-6.5.tar.gz"
md5sums   = "ac2d2629296f04c8537ca706b6977687"

build() {
    cd ncurses-${pkgver}
    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man \
        --with-shared \
        --without-debug \
        --without-normal \
        --without-ada \
        --enable-widec \
        --enable-pc-files \
        --with-pkg-config-libdir=/usr/lib/pkgconfig
    make -j$(nproc)
}

package() {
    cd ncurses-${pkgver}
    make DESTDIR="$pkgdir" install
    # Non-widec compat symlinks
    for lib in ncurses form panel menu; do
        echo "INPUT(-l${lib}w)" > "$pkgdir/usr/lib/lib${lib}.so"
        ln -sfv "${lib}w.pc" "$pkgdir/usr/lib/pkgconfig/${lib}.pc"
    done
    ln -sfv libncursesw.so "$pkgdir/usr/lib/libcurses.so" 
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}
