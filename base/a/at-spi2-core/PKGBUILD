pkgname = "at-spi2-core"
pkgver  = "2.54.2"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ("dbus-1"; "glib-2.0"; "gobject-2.0"; "gio-2.0"; "gmodule-2.0"; "libxml-2.0"; "x11"; "xtst"; "xi")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://download.gnome.org/sources/at-spi2-core/2.54/at-spi2-core-2.54.2.tar.xz"
md5sums = "510e1760a27ce9ce27a300f116d9b8a7dc8eac1f78714915685833643cb36236"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared \
		-Dsystemd=disabled
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	ninja -C build test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
