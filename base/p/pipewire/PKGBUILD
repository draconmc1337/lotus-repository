prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-pwtest.patch"
	patch -p1 < "$srcdir/patches/musl-module-zeroconf-discover.patch"
	patch -p1 < "$srcdir/patches/musl-module-snapcast-discover.patch"
	patch -p1 < "$srcdir/patches/musl-module-rtp-session.patch"
	patch -p1 < "$srcdir/patches/musl-module-raop-discover.patch"
	patch -p1 < "$srcdir/patches/musl-module-zeroconf-publish.patch"
	patch -p1 < "$srcdir/patches/musl-alsa-ucm.patch"
	patch -p1 < "$srcdir/patches/musl-alsa-mixer.patch"
	patch -p1 < "$srcdir/patches/musl-memcheck.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared \
		-Dsystemd=disabled
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	ninja -C build test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
