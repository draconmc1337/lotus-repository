# pkgbuild_Python
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "Python"
pkgver  = "3.13.3"
pkgrel  = "1"
pkgdesc = "Python 3.13 interpreter (musl-linked)"
license = "PSF-2.0"
pkgtype = "source"

depends     = ("readline"; "openssl"; "libffi"; "expat"; "sqlite"; "gdbm"; "ncurses"; "zlib"; "bzip2"; "xz")
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source    = "sources/Python-3.13.3.tar.xz"
md5sums   = "8bb5f0b8c9d9d7b87d7d98510e8d58e5"

build() {
    cd Python-${pkgver}
    ./configure \
        --prefix=/usr \
        --enable-shared \
        --with-system-expat \
        --with-system-ffi \
        --enable-optimizations \
        --with-ensurepip=yes \
        --without-static-libpython \
        ax_cv_c_float_words_bigendian=no
    make -j$(nproc)
}

package() {
    cd Python-${pkgver}
    make DESTDIR="$pkgdir" install
    ln -sfv python3 "$pkgdir/usr/bin/python"
    ln -sfv python3-config "$pkgdir/usr/bin/python-config" 
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}
