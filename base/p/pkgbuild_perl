# pkgbuild_perl
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "perl"
pkgver  = "5.40.2"
pkgrel  = "1"
pkgdesc = "Perl 5 programming language interpreter"
license = "Artistic-2.0"
pkgtype = "source"

depends     = ("zlib"; "bzip2")
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source    = "sources/perl-5.40.2.tar.xz"
md5sums   = "9ad7a269dc4053cdbeecd4fde444291b"

build() {
    cd perl-${pkgver}
    sh Configure \
        -des \
        -Dprefix=/usr \
        -Dvendorprefix=/usr \
        -Dprivlib=/usr/share/perl5/core_perl \
        -Darchlib=/usr/lib/perl5/core_perl \
        -Dsitelib=/usr/share/perl5/site_perl \
        -Dsitearch=/usr/lib/perl5/site_perl \
        -Dman1dir=/usr/share/man/man1 \
        -Dman3dir=/usr/share/man/man3 \
        -Duseshrplib \
        -Dusethreads \
        -Doptimize=-O2
    make -j$(nproc)
}

package() {
    cd perl-${pkgver}
    make DESTDIR="$pkgdir" install
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}
