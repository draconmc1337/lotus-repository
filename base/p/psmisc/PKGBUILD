pkgname = "psmisc"
pkgver  = "23.7"
pkgrel  = "1"
pkgdesc = "# TODO: add description"
license = "custom"
url     = "https://TODO"
pkgtype = "source"

depends = (
    "ncurses"
)

makedepends = (
    "git"
    "po4a"
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "https://sourceforge.net/projects/psmisc/files/psmisc/psmisc-23.7.tar.xz"
)

checksums = (
    "sha512:8180d24355b3b0f3102044916d078b1aa9a1af3d84f1e14db79e33e505390167012adbb1a8a5f47a692f3a14aba1eb5f1f8f37f328392e8635b89966af9b2128"
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/patches/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
