prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-vmstat.patch"
	patch -p1 < "$srcdir/patches/musl-pgrep.patch"
	patch -p1 < "$srcdir/patches/musl-pmap.patch"
	patch -p1 < "$srcdir/patches/musl-uptime.patch"
	patch -p1 < "$srcdir/patches/musl-slabtop.patch"
	patch -p1 < "$srcdir/patches/musl-skill.patch"
	patch -p1 < "$srcdir/patches/musl-w.patch"
	patch -p1 < "$srcdir/patches/musl-tload.patch"
	patch -p1 < "$srcdir/patches/musl-pwdx.patch"
	patch -p1 < "$srcdir/patches/musl-display.patch"
	patch -p1 < "$srcdir/patches/musl-global.patch"
	patch -p1 < "$srcdir/patches/musl-pidof.patch"
	patch -p1 < "$srcdir/patches/musl-watch.patch"
	patch -p1 < "$srcdir/patches/musl-sysctl.patch"
	patch -p1 < "$srcdir/patches/musl-free.patch"
	patch -p1 < "$srcdir/patches/musl-c.patch"
	patch -p1 < "$srcdir/patches/musl-fileutils.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--without-systemd
	make -j$(nproc)
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
