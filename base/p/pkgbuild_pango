pkgname = "pango"
pkgver  = "1.56.4"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ("glib-2.0"; "gobject-2.0"; "gio-2.0"; "gobject-introspection-1.0"; "fribidi"; "libthai"; "harfbuzz"; "fontconfig"; "xft"; "xrender"; "appleframeworks"; ""; "sysprof-capture-4")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://download.gnome.org/sources/pango/1.56/pango-1.56.4.tar.xz"
md5sums = "17065e2fcc5f5a5bdbffc884c956bfc7c451a96e8c4fb2f8ad837c6413cb5a01"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	ninja -C build test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
