prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-prim.patch"
	patch -p1 < "$srcdir/patches/musl-alloc-override.patch"
	patch -p1 < "$srcdir/patches/musl-timemodule.patch"
	patch -p1 < "$srcdir/patches/musl-_localemodule.patch"
	patch -p1 < "$srcdir/patches/musl-lowstar_endianness.patch"
	patch -p1 < "$srcdir/patches/musl-platform_triplet.patch"
	patch -p1 < "$srcdir/patches/musl-pycore_fileutils.patch"
	patch -p1 < "$srcdir/patches/musl-track.patch"
	patch -p1 < "$srcdir/patches/musl-prim.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
