# pkgbuild_dinit
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "dinit"
pkgver  = "0.20.0"
pkgrel  = "1"
pkgdesc = "Service manager and init system for Lotus Linux"
license = "Apache-2.0"
pkgtype = "source"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ("etc/dinit.d/")

source    = "sources/dinit-0.20.0.tar.gz"
md5sums   = "ed38a072dd23c707907171de96bd6787"

build() {
    cd dinit-${pkgver}
    make -j$(nproc) CXXFLAGS="-O2 -pipe" prefix=/usr
}

package() {
    cd dinit-${pkgver}
    make DESTDIR="$pkgdir" prefix=/usr install
    install -dm755 "$pkgdir/etc/dinit.d"
    # Basic single-user target
    cat > "$pkgdir/etc/dinit.d/single-user" << 'SU'
# Lotus Linux single-user service
type = internal
SU
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}

uninstall() {
    echo "warning: do not remove dinit while system is running"
    exit 1
}
