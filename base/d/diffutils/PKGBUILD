prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-util.patch"
	patch -p1 < "$srcdir/patches/musl-sdiff.patch"
	patch -p1 < "$srcdir/patches/musl-dir.patch"
	patch -p1 < "$srcdir/patches/musl-diff3.patch"
	patch -p1 < "$srcdir/patches/musl-diff.patch"
	patch -p1 < "$srcdir/patches/musl-die.patch"
	patch -p1 < "$srcdir/patches/musl-cmp.patch"
	patch -p1 < "$srcdir/patches/musl-analyze.patch"
	patch -p1 < "$srcdir/patches/musl-xstdopen.patch"
	patch -p1 < "$srcdir/patches/musl-xfreopen.patch"
	patch -p1 < "$srcdir/patches/musl-xalloc-die.patch"
	patch -p1 < "$srcdir/patches/musl-wctype.in.patch"
	patch -p1 < "$srcdir/patches/musl-wchar.in.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
