prepare() {
	cd "$srcdir/dbus-1.16.0"
	patch -p1 < "$srcdir/patches/musl-manual-backtrace.patch"
	patch -p1 < "$srcdir/patches/musl-dbus-valgrind-internal.patch"
	patch -p1 < "$srcdir/patches/musl-dbus-sysdeps-unix.patch"
}

build() {
	cd "$srcdir/dbus-1.16.0"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared \
		-Dsystemd=disabled
	ninja -C build
}

check() {
	cd "$srcdir/dbus-1.16.0"
	ninja -C build test
}

package() {
	cd "$srcdir/dbus-1.16.0"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
