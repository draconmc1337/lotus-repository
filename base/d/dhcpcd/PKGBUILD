sources = (
    "https://github.com/NetworkConfiguration/dhcpcd/archive/v10.0.10/dhcpcd-10.0.10.tar.gz"
    "patches/musl-if-linux.patch"
    "patches/musl-sha256.patch"
)

checksums = (
    "sha512:3899e8470780825f49d8002b472b8bc2500b944779c68a85c5b220b71bb9915ba856cfb5d6597ae74cc07aba3840459c8b3504fed50e280ca8b143152898167a"
    "SKIP"  # musl patch — review before using sha512
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-if-linux.patch"
	patch -p1 < "$srcdir/patches/musl-sha256.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	make -j$(nproc) PREFIX=/usr
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
