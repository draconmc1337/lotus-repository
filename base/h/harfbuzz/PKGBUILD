# pkgbuild_harfbuzz
# Lotus Linux package recipe — repo: base
# Generated by LotusPacMan v3.0.0
# Review and test before committing!

pkgname = "harfbuzz"
pkgver  = "10.2.0"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "MPL-2.0"
pkgtype = "source"

depends     = ()
makedepends = (""; "freetype2"; "FreeType"; "Freetype"; "glib-2.0"; "gobject-2.0"; "graphite2"; "icu-uc"; "ICU"; "cairo"; "cairo-ft"; "chafa"; "appleframeworks")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/harfbuzz/harfbuzz/archive/refs/tags/10.2.0.tar.gz"
md5sums = "11749926914fd488e08e744538f19329332487a6243eec39ef3c63efa154a578"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	ninja -C build test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
