pkgname = "zstd"
pkgver  = "1.5.6"
pkgrel  = "1"
pkgdesc = "# TODO: add description"
license = "BSD"
url     = "https://TODO"
pkgtype = "source"

depends = (
    "glibc"
    "libgcc"
    "libstdc++"
    "lz4"
    "xz"
    "zlib"
)

makedepends = (
    "cmake"
    "gtest"
    "ninja"
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "https://github.com/facebook/zstd/releases/download/v1.5.6/zstd-1.5.6.tar.gz"
    "patches/musl-fileio.patch"
)

checksums = (
    "sha512:54a578f2484da0520a6e9a24f501b9540a3fe3806785d6bc9db79fc095b7c142a7c121387c7eecd460ca71446603584ef1ba4d29a33ca90873338c9ffbd04f14"
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-fileio.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	make -j$(nproc) PREFIX=/usr
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make install PREFIX="$pkgdir/usr"
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
