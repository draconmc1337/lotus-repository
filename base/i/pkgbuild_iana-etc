# pkgbuild_iana-etc
# Lotus Linux base system package
# pkgtype = "source"

# Size-optimized: -Os for smaller footprint
CFLAGS_EXTRA   = "-Os -march=x86-64-v2 -mtune=generic -ffunction-sections -fdata-sections"
LDFLAGS_EXTRA  = "-Wl,--gc-sections" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "iana-etc"
pkgver  = "20260202"
pkgrel  = "1"
pkgdesc = "/etc/protocols and /etc/services from IANA"
license = "Public Domain"
pkgtype = "source"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source    = "sources/iana-etc-20260202.tar.gz"
md5sums   = "fe91258a0760912f61f1d6b200a1d885"

build() {
    cd iana-etc-${pkgver}
    true  # nothing to compile
}

package() {
    cd iana-etc-${pkgver}
    install -Dm644 protocols "$pkgdir/etc/protocols"
    install -Dm644 services  "$pkgdir/etc/services" 
}
