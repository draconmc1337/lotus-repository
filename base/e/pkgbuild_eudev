pkgname = "eudev"
pkgver  = "3.2.14"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ("blkid"; "libselinux")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/eudev-project/eudev/archive/refs/tags/v3.2.14.tar.gz"
md5sums = "c340e6c51dfc5531ac0c0fa84a34b72162acf525f9023eb9cf4931b782c8f177"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
