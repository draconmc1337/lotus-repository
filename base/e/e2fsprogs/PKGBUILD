# pkgbuild_e2fsprogs
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "e2fsprogs"
pkgver  = "1.47.3"
pkgrel  = "1"
pkgdesc = "ext2/3/4 filesystem utilities"
license = "GPL-2.0"
pkgtype = "source"

depends     = ("util-linux")
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source    = "sources/e2fsprogs-1.47.3.tar.gz"
md5sums   = "113d7a7ee0710d2a670a44692a35fd2e"

build() {
    cd e2fsprogs-${pkgver}
    mkdir build && cd build
    ../configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --enable-elf-shlibs \
        --disable-libblkid \
        --disable-libuuid \
        --disable-uuidd \
        --disable-fsck
    make -j$(nproc)
}

package() {
    cd e2fsprogs-${pkgver}
    cd build
    make DESTDIR="$pkgdir" install
    make DESTDIR="$pkgdir" install-libs
    chmod -v u+w "$pkgdir"/usr/lib/{libcom_err,libe2p,libext2fs,libss}.a
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}
