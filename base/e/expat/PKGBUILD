pkgver  = "2.6.4"
pkgrel  = "1"
pkgdesc = "# TODO: add description"
license = "MIT"
url     = "https://TODO"
pkgtype = "source"

depends = (
    "glibc"
)

makedepends = (
    "expat"
    "glib2"
    "cmake"
    "git"
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "https://github.com/libexpat/libexpat/releases/download/R_2_6_4/expat-2.6.4.tar.xz"
    "patches/musl-misc_tests.patch"
    "patches/musl-memcheck.patch"
)

checksums = (
    "sha512:620da34d98524478b445038bf1dd439790fe11169496516425fca922226797835c27549fc5fb825792b516563b24eb922d9ad8f27d20a0229e7ee8cd640dfb25"
    "SKIP"  # musl patch — review before using sha512
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-misc_tests.patch"
	patch -p1 < "$srcdir/patches/musl-memcheck.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake --build build --target test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
