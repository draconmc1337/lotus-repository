pkgname = "fontconfig"
pkgver  = "2.16.0"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "custom"
pkgtype = "source"

depends     = ()
makedepends = ("freetype2"; "freetype"; "json-c"; ""; "expat"; "libxml-2.0"; "intl"; "libxml2")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://www.freedesktop.org/software/fontconfig/release/fontconfig-2.16.0.tar.xz"
md5sums = "6a33dc555cc9ba8b10caf7695878ef134eeb36d0af366041f639b1da9b6ed220"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	ninja -C build test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
