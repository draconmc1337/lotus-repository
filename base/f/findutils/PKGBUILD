prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-test-sigusr.patch"
	patch -p1 < "$srcdir/patches/musl-locate.patch"
	patch -p1 < "$srcdir/patches/musl-system.patch"
	patch -p1 < "$srcdir/patches/musl-findutils-version.patch"
	patch -p1 < "$srcdir/patches/musl-test-xstrtol.patch"
	patch -p1 < "$srcdir/patches/musl-test-open.patch"
	patch -p1 < "$srcdir/patches/musl-test-mbsrtoc32s.patch"
	patch -p1 < "$srcdir/patches/musl-test-mbrtoc32.patch"
	patch -p1 < "$srcdir/patches/musl-test-getopt.patch"
	patch -p1 < "$srcdir/patches/musl-test-free.patch"
	patch -p1 < "$srcdir/patches/musl-test-fnmatch.patch"
	patch -p1 < "$srcdir/patches/musl-test-error.patch"
	patch -p1 < "$srcdir/patches/musl-test-canonicalize.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
