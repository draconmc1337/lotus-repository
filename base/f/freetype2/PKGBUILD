# pkgbuild_freetype2
# Lotus Linux package recipe — repo: base
# Generated by LotusPacMan v3.0.0
# Review and test before committing!

pkgname = "freetype2"
pkgver  = "2.13.3"
pkgrel  = "1"
pkgdesc = "A free, high-quality, and portable font engine."
license = "unknown"
pkgtype = "source"

depends     = ()
makedepends = ("zlib"; "bzip2"; "libpng"; "harfbuzz"; "libbrotlidec"; "freetype2")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://downloads.sourceforge.net/freetype/freetype-2.13.3.tar.xz"
md5sums = "0550350666d427c74daeb85d5ac7bb353acba5f76956395995311a9c6f063289"

prepare() {
	cd "$srcdir/freetype-2.13.3  # extracted dir: freetype-2.13.3"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/freetype-2.13.3  # extracted dir: freetype-2.13.3"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/freetype-2.13.3  # extracted dir: freetype-2.13.3"
	ninja -C build test
}

package() {
	cd "$srcdir/freetype-2.13.3  # extracted dir: freetype-2.13.3"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
