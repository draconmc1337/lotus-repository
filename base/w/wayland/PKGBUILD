# pkgbuild_wayland
# Lotus Linux package recipe — repo: base
# Generated by LotusPacMan v3.0.0
# Review and test before committing!

pkgname = "wayland"
pkgver  = "1.23.1"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ("epoll-shim"; "libffi")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://gitlab.freedesktop.org/wayland/wayland/-/archive/1.23.1/wayland-1.23.1.tar.gz"
md5sums = "158ec49af498f2558c7fbf7e8b070d010d4e270cc6076003a18a6c813f87e244"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	ninja -C build test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
