build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared \
		-Dsystemd=disabled
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
