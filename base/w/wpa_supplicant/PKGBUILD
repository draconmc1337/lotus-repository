# pkgbuild_wpa_supplicant
# Lotus Linux base system package
# pkgtype = "source" -> compiled from source
# pkgtype = "binary" -> pre-built, unpack only

pkgname = "wpa_supplicant"
pkgver  = "2.11"
pkgrel  = "1"
pkgdesc = "WPA/WPA2/WPA3 supplicant for wireless networks"
license = "BSD-3-Clause"
pkgtype = "source"

depends     = ("openssl"; "libnl")
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ("etc/wpa_supplicant/wpa_supplicant.conf")

source    = "sources/wpa_supplicant-2.11.tar.gz"
md5sums   = "72a4a00eddb7a499a58113c3361ab094"

build() {
    cd wpa_supplicant-${pkgver}
    cd wpa_supplicant
    cat > .config << 'WPACFG'
CONFIG_BACKEND=file
CONFIG_CTRL_IFACE=unix
CONFIG_DEBUG_FILE=y
CONFIG_DRIVER_NL80211=y
CONFIG_DRIVER_WEXT=y
CONFIG_EAP_GTC=y
CONFIG_EAP_LEAP=y
CONFIG_EAP_MD5=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_OTP=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TLS=y
CONFIG_EAP_TTLS=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_IPV6=y
CONFIG_LIBNL32=y
CONFIG_PEERKEY=y
CONFIG_PKCS12=y
CONFIG_READLINE=y
CONFIG_SMARTCARD=y
CONFIG_TLS=openssl
CONFIG_WPS=y
WPACFG
    make -j$(nproc)
}

package() {
    cd wpa_supplicant-${pkgver}
    cd wpa_supplicant
    install -Dm755 wpa_supplicant "$pkgdir/usr/sbin/wpa_supplicant"
    install -Dm755 wpa_cli        "$pkgdir/usr/sbin/wpa_cli"
    install -dm755 "$pkgdir/etc/wpa_supplicant"
    cat > "$pkgdir/etc/wpa_supplicant/wpa_supplicant.conf" << 'WPACNF'
# /etc/wpa_supplicant/wpa_supplicant.conf
# Managed by wpa_cli or edit manually
ctrl_interface=/run/wpa_supplicant
ctrl_interface_group=wheel
update_config=1

# Example network block:
# network={
#     ssid="MyNetwork"
#     psk="MyPassword"
# }
WPACNF
    # Strip binaries/libs to reduce size
    find "$pkgdir" -type f -name '*.so*' | while read f; do
        strip --strip-unneeded "$f" 2>/dev/null || true
    done
    find "$pkgdir" -type f | while read f; do
        case "$(file -b "$f" 2>/dev/null)" in
            *ELF*executable*) strip --strip-all "$f" 2>/dev/null || true ;;
        esac
    done
    # Remove static libs, la files, docs to save space
    find "$pkgdir" -name '*.la'   -delete 2>/dev/null || true
    find "$pkgdir" -name '*.a'    -delete 2>/dev/null || true
    rm -rf "$pkgdir"/usr/share/{info,doc,gtk-doc} 2>/dev/null || true
}
