prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-wp.patch"
	patch -p1 < "$srcdir/patches/musl-transition.patch"
	patch -p1 < "$srcdir/patches/musl-session-item.patch"
	patch -p1 < "$srcdir/patches/musl-proxy.patch"
	patch -p1 < "$srcdir/patches/musl-pipewire-object-mixin.patch"
	patch -p1 < "$srcdir/patches/musl-object.patch"
	patch -p1 < "$srcdir/patches/musl-object-interest.patch"
	patch -p1 < "$srcdir/patches/musl-metadata.patch"
	patch -p1 < "$srcdir/patches/musl-json-utils.patch"
	patch -p1 < "$srcdir/patches/musl-global-proxy.patch"
	patch -p1 < "$srcdir/patches/musl-error.patch"
	patch -p1 < "$srcdir/patches/musl-device.patch"
	patch -p1 < "$srcdir/patches/musl-conf.patch"
	patch -p1 < "$srcdir/patches/musl-component-loader.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared \
		-Dsystemd=disabled
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	ninja -C build test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
