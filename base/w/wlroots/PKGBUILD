# pkgbuild_wlroots
# Lotus Linux package recipe — repo: base
# Generated by LotusPacMan v3.0.0
# Review and test before committing!

pkgname = "wlroots"
pkgver  = "0.19.0"
pkgrel  = "1"
pkgdesc = "Wayland compositor library"
license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ("wayland-server"; "libdrm"; "pixman-1")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/0.19.0/wlroots-0.19.0.tar.gz"
md5sums = "967f3112c82e8ea18cbdc513e22196b30ccc9fad3fb836f1cff80312c66fab96"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
