)

makedepends = (
    # TODO: add build deps
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "https://github.com/kovidgoyal/kitty/releases/download/v0.36.4/kitty-0.36.4.tar.xz"
    "patches/musl-backtrace.patch"
)

checksums = (
    "sha512:3ffabb181903495d6a11a8b790e75331a5ab0986de0b7a7958ea7dfee724c29aee88c31672e2f7711d3fc51a81e1a3c84e4469228872aa62df840ded2c0d5218"
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-backtrace.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	export CGO_ENABLED=0
	go build -trimpath \
		-ldflags='-s -w' \
		-o $pkgname ./...
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	install -Dm755 $pkgname "$pkgdir/usr/bin/$pkgname"
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
