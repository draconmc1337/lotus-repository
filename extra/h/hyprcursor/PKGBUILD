# pkgbuild_hyprcursor
# Lotus Linux package recipe — repo: extra
# Generated by LotusPacMan v3.0.0
# Review and test before committing!

pkgname = "hyprcursor"
pkgver  = "0.1.10"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "BSD"
pkgtype = "source"

depends     = ()
makedepends = ("pkgconfig")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/hyprwm/hyprcursor/archive/refs/tags/v0.1.10.tar.gz"
md5sums = "67e845404164fee4c5694209b3d5f93a31b6963dbb0bfd6ed2cd96c99b316a08"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake --build build --target test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
