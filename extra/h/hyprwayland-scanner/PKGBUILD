# pkgbuild_hyprwayland-scanner
# Lotus Linux package recipe — repo: extra
# Generated by LotusPacMan v3.0.0
# Review and test before committing!

pkgname = "hyprwayland-scanner"
pkgver  = "0.4.4"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "BSD"
pkgtype = "source"

depends     = ()
makedepends = ("threads"; "pkgconfig")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/hyprwm/hyprwayland-scanner/archive/refs/tags/v0.4.4.tar.gz"
md5sums = "ac73f626019f8d819ff79a5fca06ce4768ce8a3bded6f48c404445f3afaa25ac"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
