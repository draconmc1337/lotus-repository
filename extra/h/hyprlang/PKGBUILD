# pkgbuild_hyprlang
# Lotus Linux package recipe — repo: extra
# Generated by LotusPacMan v3.0.0
# Review and test before committing!

pkgname = "hyprlang"
pkgver  = "0.6.1"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "LGPL-2.1"
pkgtype = "source"

depends     = ()
makedepends = ("pkgconfig")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/hyprwm/hyprlang/archive/refs/tags/v0.6.1.tar.gz"
md5sums = "8537bb112c633b3463850747d1fd29e1e1884df2cc4659c12736b941ba06e6bb"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake --build build --target test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
