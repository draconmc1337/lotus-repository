pkgname = "hyprland"
pkgver  = "0.55.0"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "BSD"
pkgtype = "source"

depends     = ()
makedepends = ("pkgconfig"; "python3"; "threads"; "opengl"; "glslang"; "git"; "hyprwayland-scanner"; "gtest")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/hyprwm/Hyprland/archive/refs/tags/v0.55.0.tar.gz"
md5sums = "7a547042fc291695dc4f75cc63a0c52e85a2e1e3071fa5eaf08f54c425ea271d"

prepare() {
	cd "$srcdir/Hyprland-0.55.0  # extracted dir: Hyprland-0.55.0"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/Hyprland-0.55.0  # extracted dir: Hyprland-0.55.0"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

check() {
	cd "$srcdir/Hyprland-0.55.0  # extracted dir: Hyprland-0.55.0"
	cmake --build build --target test
}

package() {
	cd "$srcdir/Hyprland-0.55.0  # extracted dir: Hyprland-0.55.0"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
