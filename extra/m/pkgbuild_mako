pkgname = "mako"
pkgver  = "1.10.0"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ("cairo"; "pango"; "pangocairo"; "glib-2.0"; "gobject-2.0"; "wayland-client"; "wayland-protocols"; "wayland-cursor"; ""; "epoll-shim"; "libsystemd"; "gdk-pixbuf-2.0")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/emersion/mako/archive/refs/tags/v1.10.0.tar.gz"
md5sums = "3ca44f6bb85c941a4f637a9787931c22ee9a7fe6b8039e6985baf863719b0f95"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared \
		-Dsystemd=disabled
	ninja -C build
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
