depends     = ()
makedepends = ("wlroots-0.19"; ""; "json-c"; "libpcre2-8"; "wayland-server"; "wayland-client"; "wayland-cursor"; "wayland-protocols"; "xkbcommon"; "cairo"; "pango"; "pangocairo"; "gdk-pixbuf-2.0"; "pixman-1"; "libevdev"; "libinput"; "xcb"; "libdrm"; "libudev"; "xcb-icccm"; "basu"; "scdoc")
replaces    = ()
conflicts   = ()
