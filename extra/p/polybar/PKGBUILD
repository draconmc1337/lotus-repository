pkgname = "polybar"
pkgver  = "3.7.2"
pkgrel  = "1"
pkgdesc = "Highly customizable status bar"
license = "MIT"
url     = "https://TODO"
pkgtype = "source"

depends = (
    # TODO: add runtime deps
)

makedepends = (
    # TODO: add build deps
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "https://github.com/polybar/polybar/releases/download/3.7.2/polybar-3.7.2.tar.gz"
    "patches/musl-error_test.patch"
    "patches/musl-request.patch"
    "patches/musl-generic.patch"
)

checksums = (
    "sha512:a0ee701533e101789f7eb95c71717ecf1d389a10b202d19261f9f71fee9d43fb8be17fb63e4a056c5e8bd62d2e669c95ee4d4b8c6bb06b933e1e4b26ab1a0624"
    "SKIP"  # musl patch — review before using sha512
    "SKIP"  # musl patch — review before using sha512
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-error_test.patch"
	patch -p1 < "$srcdir/patches/musl-request.patch"
	patch -p1 < "$srcdir/patches/musl-generic.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake --build build --target test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
