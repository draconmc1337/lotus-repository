prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-turbojpeg.patch"
	patch -p1 < "$srcdir/patches/musl-jpeglib.patch"
	patch -p1 < "$srcdir/patches/musl-jerror.patch"
	patch -p1 < "$srcdir/patches/musl-jerror.patch"
	patch -p1 < "$srcdir/patches/musl-jdicc.patch"
	patch -p1 < "$srcdir/patches/musl-jdatasrc.patch"
	patch -p1 < "$srcdir/patches/musl-jdatasrc-tj.patch"
	patch -p1 < "$srcdir/patches/musl-jdatadst.patch"
	patch -p1 < "$srcdir/patches/musl-jdatadst-tj.patch"
	patch -p1 < "$srcdir/patches/musl-jcstest.patch"
	patch -p1 < "$srcdir/patches/musl-jcicc.patch"
	patch -p1 < "$srcdir/patches/musl-example.patch"
	patch -p1 < "$srcdir/patches/musl-djpeg.patch"
	patch -p1 < "$srcdir/patches/musl-cjpeg.patch"
	patch -p1 < "$srcdir/patches/musl-cdjpeg.patch"
	patch -p1 < "$srcdir/patches/musl-cderror.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake --build build --target test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
