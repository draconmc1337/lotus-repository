license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/gokcehan/lf/archive/refs/tags/r32.tar.gz"
md5sums = "01531e7a78d8bfbe14739072e93446d003f0e4ce12032a26671fa326b73bc911"

prepare() {
	cd "$srcdir/lf-r32  # extracted dir: lf-r32"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/lf-r32  # extracted dir: lf-r32"
	export CGO_ENABLED=0
	go build -trimpath \
		-ldflags='-s -w' \
		-o $pkgname ./...
}

package() {
	cd "$srcdir/lf-r32  # extracted dir: lf-r32"
	install -Dm755 $pkgname "$pkgdir/usr/bin/$pkgname"
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
