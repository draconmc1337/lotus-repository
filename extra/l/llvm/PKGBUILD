build() {
	cd "$srcdir/llvm-project-19.1.5.src"
	python3 -m build --no-isolation --wheel
}

package() {
	cd "$srcdir/llvm-project-19.1.5.src"
	python3 -m installer --destdir="$pkgdir" dist/*.whl
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
