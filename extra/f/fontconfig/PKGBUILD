pkgname = "fontconfig"
pkgver  = "2.15.0"
pkgrel  = "1"
pkgdesc = "Font configuration library"
license = "custom"
url     = "https://TODO"
pkgtype = "source"

depends = (
    # TODO: add runtime deps
)

makedepends = (
    "freetype2"
    "freetype"
    "expat"
    "iconv"
    "libxml2"
    "fontconfig"
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "https://www.freedesktop.org/software/fontconfig/release/fontconfig-2.15.0.tar.xz"
)

checksums = (
    "sha512:754cd5fffa198fc07a39cf7df683e9adfa7f54ab41fdff8c0eacc078fd35d3e01069ba343f2b045e0b40df88d9f1fc1ee0f7565799f9cb194a59cf95b64c4417"
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/patches/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	ninja -C build test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
