pkgname = "i3status"
pkgver  = "2.14"
pkgrel  = "1"
pkgdesc = "Status line generator for i3bar"
license = "custom"
url     = "https://TODO"
pkgtype = "source"

depends = (
    # TODO: add runtime deps
)

makedepends = (
    "libconfuse"
    "yajl"
    "libpulse"
    "libnl-genl-3.0"
    "alsa"
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "https://i3wm.org/i3status/i3status-2.14.tar.xz"
    "patches/musl-i3status.patch"
)

checksums = (
    "sha512:10a1235cc314f5fc4dde4e1369a30f49118c95271f636c5803caa52d94d99ad8565b89fcd602d0c8aa7c830a79d3a3bb08e5ac8123cf07cfddc8ef0126b10f80"
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-i3status.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	ninja -C build test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
