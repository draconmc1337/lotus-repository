prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-main.patch"
	patch -p1 < "$srcdir/patches/musl-error.patch"
	patch -p1 < "$srcdir/patches/musl-scrollbar.patch"
	patch -p1 < "$srcdir/patches/musl-print.patch"
	patch -p1 < "$srcdir/patches/musl-ptyx.patch"
	patch -p1 < "$srcdir/patches/musl-fontutils.patch"
	patch -p1 < "$srcdir/patches/musl-button.patch"
	patch -p1 < "$srcdir/patches/musl-xterm.patch"
	patch -p1 < "$srcdir/patches/musl-misc.patch"
	patch -p1 < "$srcdir/patches/musl-screen.patch"
	patch -p1 < "$srcdir/patches/musl-menu.patch"
	patch -p1 < "$srcdir/patches/musl-util.patch"
	patch -p1 < "$srcdir/patches/musl-Tekproc.patch"
	patch -p1 < "$srcdir/patches/musl-charproc.patch"
	patch -p1 < "$srcdir/patches/musl-xterm_io.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
