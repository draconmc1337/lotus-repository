# pkgbuild_xcb-util-xrm
# Lotus Linux package recipe — repo: extra
# Generated by LotusPacMan v3.0.0
# Review and test before committing!

pkgname = "xcb-util-xrm"
pkgver  = "1.3"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/Airblader/xcb-util-xrm/archive/refs/tags/v1.3.tar.gz"
md5sums = "9d4a66c7366abb4840f6f822c613e1776c5898235358de728ba4554263fa0783"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	make check
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
