prepare() {
	cd "$srcdir/gtk-4.16.7"
	patch -p1 < "$srcdir/patches/musl-gtk-reftest.patch"
	patch -p1 < "$srcdir/patches/musl-gtkurilauncher.patch"
	patch -p1 < "$srcdir/patches/musl-gtksecurememory.patch"
	patch -p1 < "$srcdir/patches/musl-gtkprintdialog.patch"
	patch -p1 < "$srcdir/patches/musl-gtkopenuriportal.patch"
	patch -p1 < "$srcdir/patches/musl-gtkfontdialog.patch"
	patch -p1 < "$srcdir/patches/musl-gtkfilelauncher.patch"
	patch -p1 < "$srcdir/patches/musl-gtkfiledialog.patch"
	patch -p1 < "$srcdir/patches/musl-gtkdialogerror.patch"
	patch -p1 < "$srcdir/patches/musl-gtkcolordialog.patch"
	patch -p1 < "$srcdir/patches/musl-gtkalertdialog.patch"
	patch -p1 < "$srcdir/patches/musl-gtk.patch"
	patch -p1 < "$srcdir/patches/musl-gtkcsstokenizer.patch"
	patch -p1 < "$srcdir/patches/musl-gtkcssparser.patch"
	patch -p1 < "$srcdir/patches/musl-gtkcsserror.patch"
	patch -p1 < "$srcdir/patches/musl-gtkcss.patch"
	patch -p1 < "$srcdir/patches/musl-gdkjpeg.patch"
}

build() {
	cd "$srcdir/gtk-4.16.7"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/gtk-4.16.7"
	ninja -C build test
}

package() {
	cd "$srcdir/gtk-4.16.7"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
