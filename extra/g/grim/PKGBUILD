pkgname = "grim"
pkgver  = "1.4.1"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ("libpng"; "libjpeg"; "pixman-1"; "wayland-client"; "wayland-protocols"; "libjpeg-turbo")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://git.sr.ht/~emersion/grim/archive/v1.4.1.tar.gz"
md5sums = "5ed8e70fcd83a7e203e92d34dbb82a1342d3f13ad98a6b0310cc97e1a9342ded"

prepare() {
	cd "$srcdir/grim-v1.4.1  # extracted dir: grim-v1.4.1"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/grim-v1.4.1  # extracted dir: grim-v1.4.1"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

package() {
	cd "$srcdir/grim-v1.4.1  # extracted dir: grim-v1.4.1"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
