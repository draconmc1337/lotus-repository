prepare() {
	cd "$srcdir/glib-2.82.3"
	patch -p1 < "$srcdir/patches/musl-error.patch"
	patch -p1 < "$srcdir/patches/musl-gvariant-parser.patch"
	patch -p1 < "$srcdir/patches/musl-gunicode.patch"
	patch -p1 < "$srcdir/patches/musl-gtimezone.patch"
	patch -p1 < "$srcdir/patches/musl-gthread.patch"
	patch -p1 < "$srcdir/patches/musl-gtestutils.patch"
	patch -p1 < "$srcdir/patches/musl-gstrfuncs.patch"
	patch -p1 < "$srcdir/patches/musl-gspawn.patch"
	patch -p1 < "$srcdir/patches/musl-gspawn-posix.patch"
	patch -p1 < "$srcdir/patches/musl-gshell.patch"
	patch -p1 < "$srcdir/patches/musl-gregex.patch"
	patch -p1 < "$srcdir/patches/musl-goption.patch"
	patch -p1 < "$srcdir/patches/musl-vasnprintf.patch"
	patch -p1 < "$srcdir/patches/musl-printf-parse.patch"
	patch -p1 < "$srcdir/patches/musl-printf-parse.patch"
	patch -p1 < "$srcdir/patches/musl-gmarkup.patch"
	patch -p1 < "$srcdir/patches/musl-gmappedfile.patch"
