# pkgbuild_gtk4-layer-shell
# Lotus Linux package recipe — repo: extra
# Generated by LotusPacMan v3.0.0
# Review and test before committing!

pkgname = "gtk4-layer-shell"
pkgver  = "1.0.3"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ("gtk4"; "wayland-client"; "wayland-server"; "wayland-scanner"; "wayland-protocols")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/wmww/gtk4-layer-shell/archive/refs/tags/v1.0.3.tar.gz"
md5sums = "4d669c30b3dbc68ad69ade9752e6ebbe7be132db21a5a4734d42bc09c5481c34"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	ninja -C build test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
