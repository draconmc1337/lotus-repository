pkgver  = "1.7.5+wayland3"
pkgrel  = "1"
pkgdesc = "Header files for rofi plugins"
license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ("glib-2.0"; "gmodule-2.0"; "cairo"; "gio-unix-2.0"; "pango"; "pangocairo"; "xkbcommon"; "gdk-pixbuf-2.0"; "xcb"; "xcb-aux"; "xcb-xkb"; "xkbcommon-x11"; "xcb-ewmh"; "xcb-icccm"; "xcb-randr"; "xcb-cursor"; "xcb-xinerama"; "cairo-xcb"; "libstartup-notification-1.0"; "wayland-protocols"; "wayland-client"; "wayland-cursor"; "xcb-imdkit"; "check")
replaces    = ()
conflicts   = ()
