# Generated by LotusPacMan v4.0.0 — review before committing!

pkgname = "rxvt-unicode"
pkgver  = "9.31"
pkgrel  = "1"
pkgdesc = "Unicode-aware fork of rxvt (urxvt)"
license = "GPL-2.0"
url     = "https://TODO"
pkgtype = "source"

depends = (
    # TODO: add runtime deps
)

makedepends = (
    "libx11"
    "fontconfig"
)

replaces  = ()
conflicts = ()
backup    = ()

sources = (
    "http://dist.schmorp.de/rxvt-unicode/rxvt-unicode-9.31.tar.bz2"
    "patches/musl-ev.patch"
)

checksums = (
    "sha512:4d14ecbbb62de1b1c717277f5aae5cfb536e11392f2d4b82c884c1713f437fce8e9dd69a328fa353a55d068d8ee4121a31900f45191acec172d5dc76652b6255"
    "SKIP"  # musl patch — review before using sha512
)

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	patch -p1 < "$srcdir/patches/musl-ev.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info
	make -j$(nproc)
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -name '*.la' -delete
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
