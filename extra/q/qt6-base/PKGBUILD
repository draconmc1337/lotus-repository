prepare() {
	cd "$srcdir/qtbase-everywhere-src-6.8.1"
	patch -p1 < "$srcdir/patches/musl-imgui_draw.patch"
	patch -p1 < "$srcdir/patches/musl-tst_qsqlquerymodel.patch"
	patch -p1 < "$srcdir/patches/musl-tst_qsqlerror.patch"
	patch -p1 < "$srcdir/patches/musl-tst_databases.patch"
	patch -p1 < "$srcdir/patches/musl-tst_qsql.patch"
	patch -p1 < "$srcdir/patches/musl-tst_qsslerror.patch"
	patch -p1 < "$srcdir/patches/musl-tst_qocsp.patch"
	patch -p1 < "$srcdir/patches/musl-tst_qdtls.patch"
	patch -p1 < "$srcdir/patches/musl-tst_qnetworkreply.patch"
	patch -p1 < "$srcdir/patches/musl-tst_qpainter.patch"
	patch -p1 < "$srcdir/patches/musl-tst_qlibrary.patch"
	patch -p1 < "$srcdir/patches/musl-tst_qipaddress.patch"
	patch -p1 < "$srcdir/patches/musl-tst_qlogging.patch"
	patch -p1 < "$srcdir/patches/musl-qclass_lib_map.patch"
	patch -p1 < "$srcdir/patches/musl-qtestcrashhandler_p.patch"
	patch -p1 < "$srcdir/patches/musl-qsqltablemodel.patch"
	patch -p1 < "$srcdir/patches/musl-qsqlrelationaltablemodel.patch"
	patch -p1 < "$srcdir/patches/musl-qsqlquerymodel_p.patch"
	patch -p1 < "$srcdir/patches/musl-qsqlresult_p.patch"
	patch -p1 < "$srcdir/patches/musl-qsqlresult.patch"
	patch -p1 < "$srcdir/patches/musl-qsqlnulldriver_p.patch"
	patch -p1 < "$srcdir/patches/musl-qsqlerror.patch"
}

build() {
	cd "$srcdir/qtbase-everywhere-src-6.8.1"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

check() {
	cd "$srcdir/qtbase-everywhere-src-6.8.1"
	cmake --build build --target test
}

package() {
	cd "$srcdir/qtbase-everywhere-src-6.8.1"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
