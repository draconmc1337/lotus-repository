pkgname = "wofi"
pkgver  = "1.4.1"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "unknown"
pkgtype = "source"

depends     = ()
makedepends = ("gtk+-3.0"; "wayland-client"; "gio-unix-2.0")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://hg.sr.ht/~scoopta/wofi/archive/v1.4.1.tar.gz"
md5sums = "e95e35c03551c39178c16ad6213a88e3883a236e942d7f2666c780d934c270bb"

prepare() {
	cd "$srcdir/wofi-v1.4.1  # extracted dir: wofi-v1.4.1"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/wofi-v1.4.1  # extracted dir: wofi-v1.4.1"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

package() {
	cd "$srcdir/wofi-v1.4.1  # extracted dir: wofi-v1.4.1"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
