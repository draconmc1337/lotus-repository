# pkgbuild_hyprpaper
# Lotus Linux package recipe — repo: lotus
# Generated by LotusPacMan v3.0.0
# Review and test before committing!

pkgname = "hyprpaper"
pkgver  = "0.7.4"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "BSD"
pkgtype = "source"

depends     = ()
makedepends = ("threads"; "pkgconfig"; "hyprwayland-scanner")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/hyprwm/hyprpaper/archive/refs/tags/v0.7.4.tar.gz"
md5sums = "a2375dae58d29293b942a60cd465771b2c3c85cfcac628ec4897f11e7008666f"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
