pkgname = "cliphist"
pkgver  = "0.6.1"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "GPL-2.0"
pkgtype = "source"

depends     = ()
makedepends = ()
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/sentriz/cliphist/archive/refs/tags/v0.6.1.tar.gz"
md5sums = "db0f25ba3e9173dcb257d66cb1293e277a8bdfed11cc8d6b38b7473b0947781d"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	export CGO_ENABLED=0
	go build -trimpath \
		-ldflags='-s -w' \
		-o $pkgname ./...
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	install -Dm755 $pkgname "$pkgdir/usr/bin/$pkgname"
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
