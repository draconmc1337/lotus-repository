pkgname = "btop"
pkgver  = "1.4.7"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "Apache-2.0"
pkgtype = "source"

depends     = ()
makedepends = ("threads"; "devstat"; "kvm"; "elf"; "proplib")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/aristocratos/btop/archive/refs/tags/v1.4.7.tar.gz"
md5sums = "933de2e4d1b2211a638be463eb6e8616891bfba73aef5d38060bd8319baeefc6"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DBUILD_SHARED_LIBS=ON
	cmake --build build --parallel $(nproc)
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	cmake --build build --target test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" cmake --install build
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
