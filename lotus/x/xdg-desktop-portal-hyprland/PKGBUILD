pkgname = "xdg-desktop-portal-hyprland"
pkgver  = "1.3.9"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "BSD"
pkgtype = "source"

depends     = ()
makedepends = ("systemd")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/hyprwm/xdg-desktop-portal-hyprland/archive/refs/tags/v1.3.9.tar.gz"
md5sums = "3f7d94fd408ed5e3a9b639d3dd8502e2169decc34f285e8552434da5fddf497e"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared \
		-Dsystemd=disabled
	ninja -C build
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
