pkgname = "swappy"
pkgver  = "1.5.1"
pkgrel  = "1"
pkgdesc = "TODO: add description"
license = "MIT"
pkgtype = "source"

depends     = ()
makedepends = ("cairo"; "pango"; "gtk+-3.0"; "gio-2.0")
replaces    = ()
conflicts   = ()
backup      = ()

source  = "https://github.com/jtheoof/swappy/archive/refs/tags/v1.5.1.tar.gz"
md5sums = "266fac289d4b903d80d44746044bafe8a8b663c6032be696c651ad390bcb1850"

prepare() {
	cd "$srcdir/$pkgname-$pkgver"
	# patch -p1 < "$srcdir/fix.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	meson setup build \
		--prefix=/usr \
		--buildtype=release \
		-Ddefault_library=shared
	ninja -C build
}

check() {
	cd "$srcdir/$pkgname-$pkgver"
	ninja -C build test
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	DESTDIR="$pkgdir" ninja -C build install
	# strip binaries + shared libs
	find "$pkgdir" -type f \( -name '*.so*' -o -perm /0111 \) 2>/dev/null \
		| xargs -r strip --strip-unneeded 2>/dev/null || true
	# remove unwanted docs
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/info"
}
